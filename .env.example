# copy to .env (ignored by git) and edit. read by eda.sh, which every flow script sources.

# required: the tools directory. everything eda.sh installs (tools, PDK, nix store, scratch runs) lives here.
# a run is about 1.8 GB and the PDK 2 GB, plan for 30 GB or more.
EDA=/path/to/eda

# the PDK. sky130 (default) and gf180mcu are known to eda.sh; every other PDK_* value follows from the family
# (variant, version, standard cell library, slow and typical corner, delay cells) and can be overridden here.
# switching: set PDK_FAMILY, run ./eda.sh install pdk, then run the same flow scripts. runs of different PDKs are not comparable.
# a family that is not in the table in eda.sh needs PDK_VERSION, PDK_DIGITAL, PDK_ANALOG, STD_CELL_LIBRARY, PDK_SLOW and PDK_TYP.
PDK_FAMILY=sky130
#PDK_FAMILY=gf180mcu

# optional: directories appended to PATH for tools that are not under $EDA (ngspice)
EXTRA_PATH=/usr/local/bin
